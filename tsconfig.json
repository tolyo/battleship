{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ESNext", "DOM"],
    "target": "esnext",
    "sourceMap": false,
    "declaration": false,
    "incremental": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["./global.d.ts", "./assets/**/*.js", "./assets/**/*.ts"],
  "exclude": ["./node_modules", "./assets/**/*.test.js"]
}

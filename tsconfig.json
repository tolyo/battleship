{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ESNext", "DOM"],
    "target": "esnext",
    "sourceMap": false,
    "declaration": false,
    "incremental": true,
    "typeRoots": ["/global.d.ts", "node_modules/@types"]
  },
  "include": ["./app/**/*.js", "./app/**/*.ts"],
  "exclude": ["./node_modules"]
}

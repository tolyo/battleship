{erl_opts, [debug_info]}.
{src_dirs, [
    "src",
    "src/auth",
    "src/game",
    "src/rules",
    "src/storage",
    "src/system",
    "src/web"
]}.
{deps, [
    {cowboy,
        {git, "https://github.com/ninenines/cowboy.git",
            {ref, "e713a630f384f861fa396048f9c881ca183aeda9"}}},
    {epgsql, "4.8.0"},
    {erlydtl, "0.14.0"},
    {pooler, "1.7.0"},
    {dotenv_config, "2.3.3"},
    {jose, "1.11.10"}
]}.

{overrides, [
    {override, jose, [
        {erl_opts, [debug_info, warnings_as_errors, nowarn_deprecated_catch]}
    ]}
]}.

{shell, [
    % {config, "config/sys.config"},
    {apps, [battleship]}
]}.

{project_plugins, [erlfmt]}.
{erlfmt, [write]}.

% These warnings keep check focused on actionable application issues.
% no_unknown suppresses dependency-only Cowboy/Ranch unknown type noise that
% rebar3 cannot scope away without also damaging the PLT.
% underspecs, overspecs, and specdiffs are intentionally omitted because they
% compare specs to Dialyzer's inferred success typing. That conflicts with
% useful domain contracts such as board(), which intentionally describe the
% supported API rather than the most exact value currently inferred.
{dialyzer, [
    {warnings, [
        no_unknown,
        unmatched_returns,
        error_handling,
        extra_return,
        missing_return,
        overlapping_contract,
        opaque_union
    ]},
    {get_warnings, true}
]}.

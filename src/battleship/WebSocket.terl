/**
 * Battleship WebSocket router.
 *
 * The compiled router declares the endpoint and its stateful callbacks for the
 * web package manifest that drives `terlc serve`.
 */
module battleship.WebSocket.

import battleship.handlers.WebSocket.{cancelled, inbound, matched, peer_left, restored, waiting}.
import std.http.Router.
import std.http.WebSocket.{endpoint}.

import type std.http.Router.

pub router(): Router ->
    Router.new()
        .websocket(
            "/ws",
            endpoint(128, 65536)
                .restorable_stateful_paired_callbacks(
                    waiting,
                    peer_left,
                    "room_id",
                    "player_id",
                    "room-",
                    "player-1",
                    "player-2",
                    300000,
                    1024,
                    matched,
                    restored,
                    inbound,
                    cancelled,
                ),
        ).

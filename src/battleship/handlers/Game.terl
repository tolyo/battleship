/**
 * Battleship game configuration API.
 *
 * Returns board dimensions and fleet metadata as JSON for the browser client.
 */
module battleship.handlers.Game.

import battleship.model.game.{Board, Cell, Unit}.
import std.data.Json.
import std.http.Response.

import type battleship.model.game.Cell.
import type std.http.{Request, Response}.

pub config_json(): String ->
    Json.object()
    .put("name", Json.string("battleship"))
    .put("boardSize", Json.int(Board.row_count()))
    .put("fleetSize", Json.int(Unit.fleet_count()))
    .put("fleetCellCount", Json.int(Unit.total_size()))
    |> Json.to_string().

pub fleet_json(): String ->
    Json.object()
    .put("count", Json.int(Unit.fleet_count()))
    .put("totalSize", Json.int(Unit.total_size()))
    .put("status", Json.string("migrated-to-terlan"))
    |> Json.to_string().

pub board_json(): String ->
    Json.object()
    .put("rows", Json.int(Board.row_count()))
    .put("columns", Json.int(Board.row_count()))
    .put("cells", Json.int(Board.cell_count()))
    .put("emptyCell", Json.int(empty_cell().value))
    |> Json.to_string().

empty_cell(): Cell ->
    Cell(-1).

pub config(_request: Request): Response ->
    Response.json_text(config_json()).

pub fleet(_request: Request): Response ->
    Response.json_text(fleet_json()).

pub board(_request: Request): Response ->
    Response.json_text(board_json()).

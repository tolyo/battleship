/**
 * Battleship unit catalog.
 *
 * This module defines the immutable Terlan shape for the standard Battleship
 * fleet catalog.
 */
module battleship.model.game.Unit.

import std.collections.List.

/**
 * Ship orientation types.
 */
pub type Horizontal.

pub type Vertical.

pub type Orientation = Horizontal | Vertical.

/**
 * Positioned fleet-unit types.
 */
pub struct Ship {
    id: Int,
    size: Int,
    row: Int,
    column: Int,
    orientation: Orientation,
}.

pub horizontal(): Horizontal ->
    Horizontal.

pub vertical(): Vertical ->
    Vertical.

/**
 * Creates one default Battleship ship.
 */
pub create(id: Int, size: Int): Ship ->
    Ship(id = id, size = size, row = 2, column = 0, orientation = Horizontal).

pub place(ship: Ship, row: Int, column: Int, orientation: Orientation): Ship ->
    Ship(id = ship.id, size = ship.size, row = row, column = column, orientation = orientation).

/**
 * Returns the standard Battleship fleet.
 */
pub all(): List[Ship] ->
    List(
        create(0, 4),
        create(1, 3),
        create(2, 3),
        create(3, 2),
        create(4, 2),
        create(5, 2),
        create(6, 1),
        create(7, 1),
        create(8, 1),
        create(9, 1),
    ).

/**
 * Returns the occupied-cell total for the standard fleet.
 */
pub total_size(): Int -> 20.

pub fleet_count(): Int -> 10.
